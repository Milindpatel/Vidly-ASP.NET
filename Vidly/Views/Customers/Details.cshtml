@model Customer
@{
    ViewData["Title"] = Model.Name;
}

<h1>@Model.Name</h1>
<dl class="row">
    <dt class="col-sm-3">Membership Type</dt>
    <dd class="col-sm-9">@Model.MembershipType?.Name</dd>
    @if (Model.Birthdate.HasValue)
    {
        <dt class="col-sm-3">Date of Birth</dt>
        <dd class="col-sm-9">@Model.Birthdate.Value.ToString("d MMM yyyy")</dd>
    }
    <dt class="col-sm-3">Newsletter</dt>
    <dd class="col-sm-9">@(Model.IsSubscribedToNewsletter ? "Subscribed" : "Not subscribed")</dd>
</dl>
<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
<a class="btn btn-link" asp-action="Index">Back to customers</a>
