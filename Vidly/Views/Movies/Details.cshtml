@model Movie
@{
    ViewData["Title"] = Model.Name;
}

<h1>@Model.Name</h1>
<dl class="row">
    <dt class="col-sm-3">Genre</dt>
    <dd class="col-sm-9">@Model.Genre?.Name</dd>
    <dt class="col-sm-3">Release Date</dt>
    <dd class="col-sm-9">@Model.ReleaseDate?.ToString("d MMM yyyy")</dd>
    <dt class="col-sm-3">Date Added</dt>
    <dd class="col-sm-9">@Model.DateAdded.ToString("d MMM yyyy")</dd>
    <dt class="col-sm-3">Number in Stock</dt>
    <dd class="col-sm-9">@Model.NumberInStock</dd>
</dl>
<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
<a class="btn btn-link" asp-action="Index">Back to movies</a>
