@model IEnumerable<Movie>
@{
    ViewData["Title"] = "Movies";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Movies</h1>
    <a class="btn btn-primary" asp-action="New">New Movie</a>
</div>

<partial name="_SearchBox" />

@if (!Model.Any())
{
    <p>No movies found.</p>
}
else
{
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Movie</th>
                <th>Genre</th>
                <th>In stock</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var movie in Model)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@movie.Id">@movie.Name</a></td>
                    <td>@movie.Genre?.Name</td>
                    <td>@movie.NumberInStock</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@movie.Id">Edit</a>
                        <form asp-action="Delete" asp-route-id="@movie.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Delete @movie.Name?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
